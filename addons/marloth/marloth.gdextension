[configuration]

entry_symbol = "marloth_godot_library_init"
compatibility_minimum = "4.5"

[libraries]

linux.debug.x86_64 = "res://addons/marloth/bin/libmarloth_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/marloth/bin/libmarloth_godot.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/marloth/bin/libmarloth_godot.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/marloth/bin/libmarloth_godot.windows.template_release.x86_64.dll"

[dependencies]

linux.debug.x86_64 = {
  "res://addons/marloth/bin/libmarloth_ffi.so": ""
}
linux.release.x86_64 = {
  "res://addons/marloth/bin/libmarloth_ffi.so": ""
}
windows.debug.x86_64 = {
  "res://addons/marloth/bin/marloth_ffi.dll": ""
}
windows.release.x86_64 = {
  "res://addons/marloth/bin/marloth_ffi.dll": ""
}
