<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Marloth.Client</RootNamespace>
    <AssemblyName>Marloth.Client</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Required so Godot.SourceGenerators emit [ScriptPath] for res:// script lookup. -->
    <GodotProjectDir>$(MSBuildThisFileDirectory)..\..\</GodotProjectDir>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="GodotProjectDir" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <PackageReference Include="GodotSharp" Version="4.6.1" />
    <PackageReference Include="Godot.SourceGenerators" Version="4.6.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../Marloth.Automation/Marloth.Automation.csproj" />
    <ProjectReference Include="../Marloth.Automation.Contracts/Marloth.Automation.Contracts.csproj" />
  </ItemGroup>
</Project>
